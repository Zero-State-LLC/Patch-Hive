{
  // Static SPA on Cloudflare Workers; worker/index.ts only redirects www to the apex.
  // Production: `npm run build && npx wrangler deploy` (.env.production, api.patch-hive.com).
  // Staging: `npm run build:staging && npx wrangler deploy --env staging`
  // (.env.staging, api-staging.patch-hive.com). Set VITE_ACCOUNTS_OPEN=true in the
  // matching .env file only once that API is live.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "patchhive-frontend",
  "compatibility_date": "2026-10-01",
  // Served only from its own domain; the account's shared workers.dev subdomain is off.
  "workers_dev": false,
  "preview_urls": false,
  "main": "worker/index.ts",
  "routes": [
    { "pattern": "patch-hive.com", "custom_domain": true },
    { "pattern": "www.patch-hive.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Let the Worker see www requests before assets match them.
    "run_worker_first": true
  },
  "env": {
    "staging": {
      // Asks search engines not to index it (worker/index.ts adds X-Robots-Tag).
      "name": "patchhive-frontend-staging",
      "routes": [{ "pattern": "staging.patch-hive.com", "custom_domain": true }],
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": true
      }
    }
  }
}
