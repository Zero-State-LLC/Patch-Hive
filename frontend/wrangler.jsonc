{
  // Static SPA on Cloudflare Workers (assets only, no Worker script).
  // Build with VITE_API_BASE_URL set to the public API, then `npx wrangler deploy`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "patchhive-frontend",
  "compatibility_date": "2026-10-01",
  // Served only from its own domain; the account's shared workers.dev subdomain is off.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "patch-hive.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
