# PatchHive Environment Variables
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/patchhive

# Backend API
SECRET_KEY=your-secret-key-here-generate-with-openssl
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
APP_NAME=PatchHive
APP_VERSION=1.0.0
ABX_CORE_VERSION=1.3
ENFORCE_SEED_TRACEABILITY=true
ENVIRONMENT=development

# Canonical scope gates: historical surfaces are disabled by default.
ENABLE_LEGACY_SOCIAL=false
ENABLE_LEGACY_PUBLISHING=false
ENABLE_LEGACY_LEADERBOARDS=false
ENABLE_LEGACY_REFERRALS=false
# Transitional: legacy POST /api/export/runs/{id}/patchbook debit. Prefer /api/canon/exports.
ENABLE_LEGACY_PATCHBOOK_DEBIT=false

# Payments remain test-only. Production activation requires a separate reviewed change.
STRIPE_TEST_MODE=true
ALLOW_PRODUCTION_PAYMENTS=false
STRIPE_WEBHOOK_SECRET=
# Optional; defaults to SECRET_KEY when >= 32 bytes.
DOWNLOAD_TOKEN_SECRET=

# PatchBook Design Engine (default off). Staging walkthrough:
# docs/design/PATCHBOOK_STAGING_ENABLEMENT.md
ENABLE_PATCHBOOK_DESIGN_ENGINE=false
ENABLE_CANON_EXPORT_FULFILLMENT=false
ENABLE_INLINE_EXPORT_FULFILLMENT=false
ENABLE_PATCHBOOK_PUBLICATION_PROFILE=false
REQUIRE_SEALED_GENERATED_PATCHES=false
DESIGN_ENGINE_DEFAULT_TIER=core
PREVIEW_RATE_LIMIT_PER_MINUTE=30
# EXPORT_STORE_ROOT=./exports

# Spec 006 Clef decision provider (Cloudflare Workers AI). DEFAULT OFF and fail-closed.
# DECISION_PROVIDER=clef with ENABLE_CLEF_PROVIDER=false returns CLEF_DISABLED and makes
# no network call. Credentials are operator-provisioned secrets; never commit values.
# See specs/006-cloudflare-edge-clef/DEPLOY_NOTES.md.
# ENABLE_DECISION_INTELLIGENCE=false
# DECISION_PROVIDER=disabled
ENABLE_CLEF_PROVIDER=false
CLEF_MODEL=clef
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
# CLEF_BASE_URL=https://api.cloudflare.com/client/v4
# CLEF_TIMEOUT_SECONDS=10

# Frontend
VITE_API_URL=http://localhost:8000
# Read by frontend/src/lib/api.ts. Edge deploys (Spec 006 T030) set this to the
# operator-locked API hostname; the hostname is not chosen in this repo.
# VITE_API_BASE_URL=http://localhost:8000/api

# Dev only: allow SQLAlchemy create_all on startup (never for staging/prod)
# ALLOW_CREATE_ALL=false

# Deploy/staging: run alembic upgrade head in entrypoint
# RUN_MIGRATIONS=true

