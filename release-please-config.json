{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "prerelease": true,
  "versioning": "prerelease",
  "prerelease-type": "alpha",
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Added"
    },
    {
      "type": "fix",
      "section": "Fixed"
    },
    {
      "type": "perf",
      "section": "Changed"
    },
    {
      "type": "refactor",
      "section": "Changed"
    },
    {
      "type": "spec",
      "section": "Specifications"
    },
    {
      "type": "data",
      "section": "Data"
    },
    {
      "type": "ops",
      "section": "Operations"
    },
    {
      "type": "infra",
      "section": "Operations"
    },
    {
      "type": "ci",
      "section": "Operations"
    },
    {
      "type": "docs",
      "section": "Documentation"
    },
    {
      "type": "revert",
      "section": "Reverted"
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Chores",
      "hidden": true
    },
    {
      "type": "build",
      "section": "Chores",
      "hidden": true
    },
    {
      "type": "style",
      "section": "Chores",
      "hidden": true
    }
  ],
  "packages": {
    ".": {
      "package-name": "patchhive",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "frontend/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "toml",
          "path": "backend/pyproject.toml",
          "jsonpath": "$.project.version"
        }
      ]
    }
  }
}
