{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "patchhive.vision-pilot-case.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "partition",
    "cohort",
    "rights_and_consent",
    "image_asset_hashes",
    "scene_conditions",
    "ground_truth_inventory",
    "annotation_status",
    "reviewers",
    "candidate_set_hash",
    "expected_choice",
    "none_of_above_allowed",
    "ground_truth_status",
    "contamination"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "partition": {
      "enum": [
        "development",
        "validation",
        "locked_test",
        "adversarial_degraded",
        "unknown_open_set"
      ]
    },
    "cohort": {
      "type": "string",
      "minLength": 1
    },
    "rights_and_consent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rights_status",
        "source_url"
      ],
      "properties": {
        "rights_status": {
          "enum": [
            "RIGHTS_CONFIRMED",
            "RIGHTS_AMBIGUOUS",
            "RIGHTS_RESTRICTED",
            "RIGHTS_UNKNOWN"
          ]
        },
        "source_url": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        },
        "consent_record": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "image_asset_hashes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "scene_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ground_truth_inventory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ground_truth_status": {
      "enum": [
        "UNVERIFIED",
        "OPERATOR_VERIFIED",
        "TWO_SOURCE_VERIFIED"
      ]
    },
    "annotation_status": {
      "enum": [
        "DISCOVERED",
        "ANNOTATED",
        "REVIEWED"
      ]
    },
    "reviewers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "candidate_set_hash": {
      "type": "string",
      "minLength": 1
    },
    "expected_choice": {
      "type": "string",
      "minLength": 1
    },
    "none_of_above_allowed": {
      "const": true
    },
    "contamination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "used_for_tuning"
      ],
      "properties": {
        "used_for_tuning": {
          "type": "boolean"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
